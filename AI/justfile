set shell := ["zsh", "-cu"]

default:
    @just --list

install:
    pip3 install ultralytics opencv-python

run:
    python3 main.py

webcam source="0":
    python3 -c 'import runpy, sys; sys.argv = ["main.py", "{{source}}"]; runpy.run_path("main.py", run_name="__main__")'

check:
    python3 -m py_compile main.py

clean:
    rm -rf __pycache__
