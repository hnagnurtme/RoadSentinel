APP_NAME=RoadSentinel Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Example PostgreSQL URL:
# postgresql://<user>:<password>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadsentinel
SQL_ECHO=false

# Comma-separated values
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Driver event classification / anti-noise tuning
DRIVER_EVENT_UNKNOWN_ENTER_FRAMES=12

DRIVER_EVENT_SLEEP_ENTER_FRAMES=3
DRIVER_EVENT_SLEEP_EXIT_FRAMES=1
DRIVER_EVENT_PHONE_ENTER_FRAMES=3
DRIVER_EVENT_PHONE_EXIT_FRAMES=1
DRIVER_EVENT_DISTRACTED_ENTER_FRAMES=4
DRIVER_EVENT_DISTRACTED_EXIT_FRAMES=2
DRIVER_EVENT_DROWSY_ENTER_FRAMES=3
DRIVER_EVENT_DROWSY_EXIT_FRAMES=1

DRIVER_EVENT_PHONE_DECAY_MISS_FRAMES=2
DRIVER_EVENT_DROWSY_DECAY_MISS_FRAMES=2

DRIVER_EVENT_MIN_SLEEP_CONFIDENCE=0.5
DRIVER_EVENT_MIN_PHONE_CONFIDENCE=0.6
DRIVER_EVENT_MIN_DISTRACTED_CONFIDENCE=0.6
DRIVER_EVENT_MIN_DROWSY_CONFIDENCE=0.55

# Comma-separated values
DRIVER_EVENT_PRESENCE_LABELS=face,eye,person,driver
DRIVER_EVENT_PRIORITY=using_phone,sleeping,distracted

# Seconds
DRIVER_EVENT_SLEEPING_RELEASE_GRACE_SECONDS=1.0
DRIVER_EVENT_PHONE_RELEASE_GRACE_SECONDS=0.8
DRIVER_EVENT_DROWSY_RELEASE_GRACE_SECONDS=0.8
DRIVER_EVENT_ALERT_COOLDOWN_SECONDS=2.0
DRIVER_EVENT_PHONE_MIN_ALERT_SECONDS=1.2
DRIVER_EVENT_DROWSY_MIN_ALERT_SECONDS=1.5

# Sleeping evidence / DB alert pipeline
DRIVER_EVENT_EVIDENCE_ENABLED=true
DRIVER_EVENT_EVIDENCE_SECONDS=8
DRIVER_EVENT_EVIDENCE_FPS=5
DRIVER_EVENT_EVIDENCE_CODEC=mp4v

DRIVER_EVENT_CLOUDINARY_ENABLED=false
DRIVER_EVENT_CLOUDINARY_CLOUD_NAME=
DRIVER_EVENT_CLOUDINARY_API_KEY=
DRIVER_EVENT_CLOUDINARY_API_SECRET=
DRIVER_EVENT_CLOUDINARY_FOLDER=roadsentinel/backend
# If these are left empty, backend can fallback to Gateway/env.yml cloudinary.*

# Default UUIDs used when creating DB alert from websocket sleeping evidence
DRIVER_EVENT_ALERT_DEVICE_ID=3fa85f64-5717-4562-b3fc-2c963f66afa6
DRIVER_EVENT_ALERT_DRIVER_ID=1edc79dd-1331-454e-b64d-12fb8e77f464
DRIVER_EVENT_ALERT_VEHICLE_ID=0e225dd7-deba-4cfa-91ef-dfa30a3942d1
